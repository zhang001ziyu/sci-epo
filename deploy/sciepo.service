# Template for a single-owner deployment. Replace studio.example.com and the Bun path.
[Unit]
Description=Sci-epo screenwriting workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sciepo
Group=sciepo
WorkingDirectory=/opt/sci-epo/current
Environment=NODE_ENV=production
Environment=SCIEPO_PREBUILT=true
Environment=SCIEPO_PORT=4317
Environment=SCIEPO_PUBLIC_ORIGIN=https://studio.example.com
Environment=SCIEPO_DB_PATH=/var/lib/sci-epo/studio.sqlite
ExecStart=/usr/local/bin/bun run src/server/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sci-epo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
