# Server-only settings. No credentials belong in the repository.
SCIEPO_PORT=4317
# SCIEPO_DB_PATH=data/sci-epo.sqlite
# A public HTTPS deployment enables password login, secure cookies and CSRF checks.
# SCIEPO_PUBLIC_ORIGIN=https://studio.example.com
# Optional first-start model service. Afterwards, manage services, models and
# role assignments on the 模型服务 (Model services) page; restarts never overwrite them.
# SCIEPO_MODEL_PROVIDER=openai
# SCIEPO_MODEL_PROTOCOL=chat_completions
# SCIEPO_MODEL_BASE_URL=https://your-provider.example/v1
# SCIEPO_MODEL_ID=your-model
# SCIEPO_MODEL_API_KEY=
